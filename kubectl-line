    elif line.startswith(f"#{PLUGIN_NAME}:{PIPE_FMT_IN}: "):
        in_format = line[len(PLUGIN_NAME) + 4 + len(PIPE_FMT_IN):-1]
    elif line.startswith(f"#{PLUGIN_NAME}:{PIPE_NS_IN}: "):
