                        ):  # name does not support kind, nsed
                            l_print_t(
                                P_ERROR, f"api-resources format name not supported"
                            )
                            break
                        if command == "sh":
                            toCheck = " ".join(args[2:])
                            for item in content:
                                os.environ[f"{PLUGIN_UNAME}_{item}"] = content[item]
                        elif args[0].split("/")[-1] == P_SHORTCUT:
                            toCheck = " ".join(["kubectl", P_SHORTCUT] + args[1:])
                        else:
                            toCheck = " ".join(["kubectl"] + args[1:])
                        toExec = generate_to_exec(p_in, toCheck)
                        if p_in["kind"] != P_UNKNOWN:
                            toExec = toExec.replace("{{kind}}", p_in["kind"])
                        if p_in["name"] != P_UNKNOWN:
