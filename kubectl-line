                        outputPresent = "-o" in args[1:]
                        if outputPresent:
                            outputOptions = args[1:][args[1:].index("-o") + 1] # didn't check args len
                            l_print_t(PIPE_FMT_IN,f"{outputOptions}")
                        else:
                            l_print_t(PIPE_FMT_IN,f"{P_DEFAULT}")
                        l_print_t(PIPE_NOTE_IN,f"appending --verbs=get,list")
                        toExec = toExec + " --verbs=get,list"
                    for item in content:
