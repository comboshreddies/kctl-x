                            prev_p_in['nsed'] = p_in['nsed']
                        if p_in['kind'] != P_UNKNOWN and prev_p_in['kind'] != p_in['kind']:
                            l_print_t(PIPE_KIND_IN,f"{p_in['kind']}")
                            prev_p_in['kind'] = p_in['kind']
                        outputPresent = "-o" in args[1:]
                        if outputPresent:
                            outputOptions = args[1:][args[1:].index("-o") + 1]
                            if prev_p_in['format'] != P_UNKNOWN:
                                l_print_t(PIPE_FMT_IN,f"{outputOptions}")
                                prev_p_in['format'] = outputOptions
                        else:
                            if prev_p_in['format'] != P_DEFAULT:
                                l_print_t(PIPE_FMT_IN,f"{P_DEFAULT}")
                                prev_p_in['format'] = P_DEFAULT
                    for item in content:
                        toExec = toExec.replace("{{"+item+"}}", content[item])
                    if plugin_debug:
                        l_print_e(P_EXEC, f"{toExec}")
                    os.system(toExec)
                else:  # cmd get : unknown format, best effort
                    if line_num == 0 and line.isupper():
                        line_num += 1
                        position, columns = read_header_line(line)
                        continue
                    else:  # loading fields
                        content = read_row_from_line(position, columns)
                        line_num += 1
                    if 'cmd' in p_in and p_in['cmd'] != P_UNKNOWN and 'IN_CMD' not in content:
                        content['IN_CMD'] = p_in['cmd']
                    if 'CONTEXT' in content:
                        p_in['ctx'] = content['CONTEXT']
                    if 'NAMESPACE' in content:
                        p_in['ns'] = content['NAMESPACE']
                    if 'KIND' in content:
                        p_in['kind'] = content['KIND']
                    if 'NAME' in content:
                        p_in['name'] = content['NAME']
                    if p_in['ctx'] == P_UNKNOWN and p_in['ns'] == P_UNKNOWN and p_in['kind'] == P_UNKNOWN and p_in['name'] == P_UNKNOWN:
                        # cmd get : no recognized format, best effort failed
                        l_print_t(P_ERROR,
                            f"not enough input: CONTEXT, NAMESPACE, KIND, NAME"
                        )
                        break
                    else:
                        if args[0].split("/")[-1] == P_SHORTCUT:
                            toCheck = " ".join(["kubectl", P_SHORTCUT] + args[1:])
                        else:
                            toCheck = " ".join(["kubectl"] + args[1:])
                        toExec = toCheck.replace(" _ ", " {{cctx}} {{cns}} ")
                        toExec = toExec.replace("{{name}}", p_in['name'])
                        if p_in['ctx'] != P_UNKNOWN:
                            toExec = toExec.replace("{{ctx}}", p_in['ctx'])
                            toExec = toExec.replace(
                                "{{cctx}}", "--context " + p_in['ctx']
                            )
                        else:
                            toExec = toExec.replace("{{ctx}}", "")
                            toExec = toExec.replace("{{cctx}}", "")
                        if p_in['ns'] != "<none>" and p_in['ns'] != P_UNKNOWN:
                            toExec = toExec.replace("{{ns}}", p_in['ns'])
                            toExec = toExec.replace("{{cns}}", "-n " + p_in['ns'])
                        else:
                            toExec = toExec.replace("{{ns}}", "")
                            toExec = toExec.replace("{{cns}}", "")
                        if p_in['name'] != '<none>' and p_in['name'] != P_UNKNOWN:
                            toExec = toExec.replace("{{name}}",p_in['name'])
                        if p_in['kind'] != '<none>' and p_in['kind'] != P_UNKNOWN:
                            toExec = toExec.replace("{{kind}}", p_in['kind'])
                        if detect_output() == "pipe":
                            l_print_t(PIPE_CMD_IN,f"{command}")
                            if p_in['ns'] != P_UNKNOWN and prev_p_in['ns'] != p_in['ns']:
                                l_print_t(PIPE_NS_IN,f"{p_in['ns']}")
                                prev_p_in['ns'] = p_in['ns']
                            if p_in['ctx'] != P_UNKNOWN and prev_p_in['ctx'] != p_in['ctx']:
                                l_print_t(PIPE_CTX_IN,f"{p_in['ctx']}")
                                prev_p_in['ctx'] = p_in['ctx']
                            if p_in['kind'] != P_UNKNOWN and prev_p_in['kind'] != p_in['kind']:
                                l_print_t(PIPE_KIND_IN,f"{p_in['kind']}")
                                prev_p_in['kind'] = p_in['kind']
                            execWords = toExec.split()
                            noheaderPresent = "--no-headers" in execWords
                            outputPresent = "-o" in execWords
                            outputOptions = P_DEFAULT
                            if outputPresent:
                                outputOptions = execWords[execWords.index("-o") + 1]
                            if outputPresent:
                                l_print_t(P_CUSTOM_FMT,f"{outputOptions}")
                            if not outputPresent:
                                for word in execWords:
                                    if word.startswith("--output="):
                                        outputPresent = True
                                        outputOptions = word[0:]
                                        l_print_t(P_CUSTOM_FMT,f"{outputOptions}")
                            if noheaderPresent:
                                toExec = toExec.replace("--no-headers", "")
                        for item in content:
                            toExec = toExec.replace("{{" + item + "}}", content[item])
                        if plugin_debug:
                            l_print_e(P_EXEC, f"{toExec}")
                        os.system(toExec)
                    break
    else:  # cmd get, no input pipe
        if detect_output() == "pipe":
            l_print_t(PIPE_CMD_IN,f"{command}")
            if cmd_ctx != P_UNKNOWN:
                l_print_t(PIPE_CTX_IN,f"{cmd_ctx}")
            # TODO cmd_ns not needed if get ns is used
            if cmd_ns != P_UNKNOWN:
                if cmd_kind != "ns":
                   l_print_t(PIPE_NS_IN,f"{cmd_ns}")
            if cmd_kind != P_UNKNOWN:
                l_print_t(PIPE_KIND_IN,f"{cmd_kind}")
            if cmd_name != P_UNKNOWN:
                l_print_t(PIPE_NAME_IN,f"{cmd_name}")
            # TODO pass label selectors
            outputPresent = "-o" in args[1:]
            if outputPresent:
                outputOptions = args[1:][args[1:].index("-o") + 1]
                l_print_t(PIPE_FMT_IN,f"{outputOptions}")
            else:
                l_print_t(PIPE_FMT_IN,f"{P_DEFAULT}")
            execArgs = (
                    ["kubectl"]
                    + args[1:]
            )
        else:  # cmd api resources no input pipe, no output pipe, just exec command
            execArgs = ["kubectl"] + args[1:]
        os.system(" ".join(execArgs))
elif command == "api-resources":  # cmd api-resources
    if detect_input() == "fifo":
        for line in sys.stdin:
            if prevLine:
                line = prevLine + line
            if line[-1] != "\n":
                prevLine = line
                continue
            if line.startswith(f"#{PLUGIN_NAME}:"):
                p_in = detect_in_plugin_content(p_in,line)
                line_num = 0
                continue
            else:  # no PIPE_KIND_IN in this command line
                if p_in['cmd'] not in ["config_get-contexts",P_UNKNOWN]:
