def int_signal_handler(sig, frame):
    print(f"Exit on Ctrl+C!")
    os.kill(os.getppid(), signal.SIGTERM)
    sys.exit(0)

def signal_ignore(sig, frame):
    pass

def term_signal_handler(sig, frame):
    sys.exit(0)

def detect_input():
    if sys.stdin.isatty():
        return "terminal"
    else:
        if S_ISFIFO(os.fstat(0).st_mode):
            return "fifo"
        else:
            return "pipe"

def detect_output():
    if sys.stdout.isatty():
        return "terminal"
    else:
        return "pipe"

def l_print_t(type,arg):
    print(f"#{PLUGIN_NAME}:{type}: {arg}",flush=True)

def l_print_e(type,arg):
    print(f"#{PLUGIN_NAME}:{type}: {arg}",flush=True,file=sys.stderr)

def available_plugins():
    plugins = []
    command = ["kubectl", "plugin", "list"]
    result = subprocess.run(command, capture_output=True, text=True, check=True)
    command_output = result.stdout
    lines = command_output.split("\n")
    for line in lines:
        if "/kubectl-" in line:
            offset = line.rindex("/kubectl-") + len("/kubectl-")
            plugins.append(line[offset:])
    return plugins

def set_pipe_input():
    p = {}
    for i in ['format','ctx','cmd','kind','nsed','name','ns','get','obj','kc']:
        p[i] = P_UNKNOWN
    return p

def set_cmd_input():
    cmd = {}
    for i in ['ctx','ns','kind','name','kc']:
        cmd[i] = P_UNKNOWN
    return cmd

def detect_in_plugin_content(pin,line):
    if line.startswith(f"#{PLUGIN_NAME}:{PIPE_CMD_IN}: "):
        pin['cmd'] = line[len(PLUGIN_NAME) + 4 + len(PIPE_CMD_IN):-1]
    elif line.startswith(f"#{PLUGIN_NAME}:{PIPE_FMT_IN}: "):
        pin['format'] = line[len(PLUGIN_NAME) + 4 + len(PIPE_FMT_IN):-1]
    elif line.startswith(f"#{PLUGIN_NAME}:{PIPE_NS_IN}: "):
        pin['ns'] = line[len(PLUGIN_NAME) + 4 + len(PIPE_NS_IN):-1]
    elif line.startswith(f"#{PLUGIN_NAME}:{PIPE_KIND_IN}: "):
        pin['kind'] = line[len(PLUGIN_NAME) + 4 + len(PIPE_KIND_IN):-1]
    elif line.startswith(f"#{PLUGIN_NAME}:{PIPE_CTX_IN}: "):
        pin['ctx'] = line[len(PLUGIN_NAME) + 4 + len(PIPE_CTX_IN):-1]
    elif line.startswith(f"#{PLUGIN_NAME}:{PIPE_NSED_IN}: "):
        pin['nsed'] = line[len(PLUGIN_NAME) + 4 + len(PIPE_NSED_IN):-1]
    elif line.startswith(f"#{PLUGIN_NAME}:{PIPE_KC_IN}: "):
        pin['kc'] = line[len(PLUGIN_NAME) + 4 + len(PIPE_KC_IN):-1]
    if pin['cmd'] == "get" and line.startswith(f"#{PLUGIN_NAME}:{PIPE_GET_IN}: "):
        pin['get'] = line[len(PLUGIN_NAME) + 4 + len(PIPE_GET_IN):-1]
    return pin

def read_header_line(line):
    position = []
    columns = []
    words = line.split()
    ofs = 0
    for idx in range(len(words)):
        pos = ofs + line[ofs:].index(words[idx])
        position.append(pos)
        columns.append(words[idx])
        ofs = pos + len(words[idx])
    return (position,columns)

def read_row_from_line(position,columns,line):
    content = {}
    if len(position):
        item = ""
        for idx in range(len(position)):
            if idx + 1 != len(position):
                item = line[position[idx]:position[idx + 1] - 1]
            else:
                item = line[position[idx]:-1]
            content[columns[idx]] = item.rstrip()
    return content

def fetch_kubectl_options():
    execArgs = ["kubectl", "options"]
    result = subprocess.run(execArgs, capture_output=True, text=True, check=True)
    command_output = result.stdout
    lines = command_output.split("\n")
    list = []
    for line in lines:
        left_part = line.split(':')[0]
        words = left_part.split()
        if len(words) > 0 and words[0][0] == '-':
            for word in words:
                if word[0] == "-" and word[0:2] != "--" and word[-1] == ",":
                    list.append(word[:-1])
                if word[0:2] == "--" and "=" in word:
                    list.append(word[:word.index('=')])
    return list

def fetch_kubectl_cmds():
    execArgs = ["kubectl"]
    result = subprocess.run(execArgs, capture_output=True, text=True, check=True)
    command_output = result.stdout
    lines = command_output.split("\n")
    list = []
    skip = False
    for line in lines:
        if line == "Subcommands provided by plugins:":
            skip = True
        if line == "Usage:":
            break
        if line == "":
            skip = False
        if skip:
            continue
        if line and line[-1] != ":" and line[:2] == "  ":
            words = line.split()
            list.append(words[0])
    return list

def fetch_kubectl_gettable_resources(context=""):
    if context:
        execArgs = ["kubectl", "--context", context, "api-resources", "--verbs=get,list", "--no-headers"]
    else:
        execArgs = ["kubectl", "api-resources", "--verbs=get,list", "--no-headers"]
    result = subprocess.run(execArgs, capture_output=True, text=True, check=True)
    command_output = result.stdout
    lines = command_output.split("\n")
    list = []
    for line in lines:
        sublist = []
        words = line.split()
        if len(words) == 5:
            sublist = words
        elif len(words) == 4:
            sublist = [words[0], "", words[1], words[2], words[3]]
        list.append(sublist)
    return list

def fetch_kubectl_cmd_options(cmd, context=""):
    if context:
        execArgs = ["kubectl", "--context", context, cmd, "-h"]
    else:
        execArgs = ["kubectl", cmd, "-h"]
    result = subprocess.run(execArgs, capture_output=True, text=True, check=True)
    command_output = result.stdout
    lines = command_output.split("\n")
    list = []
    skip = True
    for line in lines:
        if line == "Options:":
            skip = False
        if line == "Usage:":
            break
        if skip:
            continue
        left_part = line.split(':')[0]
        words = left_part.split()
        if len(words) > 0 and words[0][0] == '-':
            for word in words:
                if word[0] == "-" and word[0:2] != "--" and word[-1] == ",":
                    list.append(word[:-1])
                if word[0:2] == "--" and "=" in word:
                    list.append(word[:word.index('=')])
    return list

def system_exec(cmd):
    # os.system(cmd)
    # TO CONSIDER request caching !?
    if P_DEBUG:
        l_print_e(P_EXEC, f"{cmd}")
    execArgs = ["/bin/bash", "-c",cmd]
    try:
        result = subprocess.run(execArgs, capture_output=True, text=True, check=True)
        command_output = result.stdout
    except subprocess.CalledProcessError as e:
        print(f"Error executing command: {e.cmd}")
        print(f"Return code: {e.returncode}")
        print(f"Standard output: {e.stdout}")
        print(f"Standard error: {e.stderr}")
        return
    lines = command_output.split("\n")
    for i in range(len(lines)):
        if i == len(lines) - 1 :
            print(lines[i],end="")
        else:
            print(lines[i])

def pass_output_format(args):
    outputPresent = "-o" in args[1:]
    if outputPresent:
        if len(args) > args[1:].index("-o") + 1:
            outputOptions = args[1:][args[1:].index("-o") + 1]
            l_print_t(PIPE_FMT_IN, f"{outputOptions}")
            return
    else:
        right_args = args[1:]
        for i in range(len(right_args)):
            if right_args[i].startswith("--options"):
                if '=' in right_args[i]:
                    eq_offset = right_args[i].index('=')
                    outputOptions = right_args[i][eq_offset+1 :]
                    l_print_t(PIPE_FMT_IN, f"{outputOptions}")
                    return
                elif len(right_args) > i + 1:
                    outputOptions = right_args[i+1]
                    l_print_t(PIPE_FMT_IN, f"{outputOptions}")
                    return
    l_print_t(PIPE_FMT_IN, f"{P_DEFAULT}")

def extract_get_options(context,extracted,kctlOpts):
    get_extracted = []
    if context == P_UNKNOWN:
        get_opts = fetch_kubectl_cmd_options("get")
    else:
        get_opts = fetch_kubectl_cmd_options("get",context=context)
    i = 0
    while i < len(extracted):
        if extracted[i] in get_opts:
            i += 2
            continue
        if "=" in extracted[i]:
            eq_index = extracted[i][:-1].index("=")
            if args[i][:eq_index] in kctlOpts:
                i += 1
                continue
        get_extracted.append(extracted[i])
        i += 1
    return get_extracted

def extract_args(args,cmd,kctlOpts):
    extracted = []
    extracted_args_position = []
    i = 0
    while i < len(args):
        if args[i] in kctlOpts:
            if args[i] in ['-n','--namespace'] and len(args) > i + 1:
                cmd['ns'] = args[i+1]
            if args[i] == '--context' and len(args) > i + 1:
                cmd['ctx'] = args[i+1]
            if args[i] == '--kubeconfig' and len(args) > i + 1:
                cmd['kc'] = args[i+1]
            i += 2
            continue
        if "=" in args[i][:-1]:
            eq_index = args[i][:-1].index("=")
            if args[i][:eq_index] in kctlOptions:
                if args[i][:eq_index] in ['-n','--namespace']:
                    cmd['ns'] = args[i][eq_index+1]
                if args[i][:eq_index] == '--context':
                    cmd['ctx'] = args[i][eq_index+1]
                if args[i][:eq_index] == '--kubeconfig':
                    cmd['kc'] = args[i][eq_index+1]
            i += 1
            continue
        if args[i][0:2] == "{{" and args[i][-2:] == "}}":
            i += 1
            continue
        if args[i] == P_SHORTCUT:
            i += 1
            continue
        extracted.append(args[i])
        extracted_args_position.append(i)
        i += 1
    return extracted,extracted_args_position,cmd

def generate_to_exec(p_in, toCheck):
        if p_in['ctx'] == P_UNKNOWN: # no ctx
            if p_in['kc'] == P_UNKNOWN: # no ctx, kc
                if p_in['nsed'] == 'false': # no ctx, no kc, no nsed
                    toExec = toCheck
                else: # nsed true
                    toExec = toCheck.replace(" _ ", " {{cns}} ")
                    toExec = toExec.replace("{{nsed}}", p_in['nsed'])
                    if p_in['ns'] != P_UNKNOWN and p_in['ns'] != "<none>":
                        toExec = toExec.replace("{{cns}}", p_in['ns'])
                        toExec = toExec.replace("{{ns}}", p_in['ns'])
                    else:
                        toExec = toExec.replace("{{cns}}","")
            else: # no ctx, kc
                if p_in['nsed'] == 'false':
                    toExec = toCheck.replace(" _ ", " {{ckc}} ")
                    toExec = toExec.replace("{{ckc}}", "--kubeconfig " + p_in['kc'])
                    toExec = toExec.replace("{{kc}}", p_in['kc'])
                else: # no ctx, kc, nsed true
                    toExec = toCheck.replace(" _ ", " {{ckc}} {{cns}} ")
                    toExec = toExec.replace("{{nsed}}", p_in['nsed'])
                    toExec = toExec.replace("{{ckc}}", "--kubeconfig " + p_in['kc'])
                    toExec = toExec.replace("{{kc}}", p_in['kc'])
                    if p_in['ns'] != P_UNKNOWN and p_in['ns'] != "<none>":
                        toExec = toExec.replace("{{cns}}", " -n " + p_in['ns'])
                        toExec = toExec.replace("{{ns}}", p_in['ns'])
                    else:
                        toExec = toExec.replace("{{cns}}","")
        else: # ctx
            if p_in['kc'] == P_UNKNOWN: # ctx, no kc
                if p_in['nsed'] == 'false': # ctx, no kc, no nsed
                    toExec = toCheck.replace(" _ ", " {{cctx}} ")
                    toExec = toExec.replace("{{cctx}}", "--context " + p_in['ctx'])
                    toExec = toExec.replace("{{ctx}}", p_in['ctx'])
                else: # ctx, no kc, nsed true
                    toExec = toCheck.replace(" _ ", " {{cctx}} {{cns}} ")
                    toExec = toExec.replace("{{nsed}}", p_in['nsed'])
                    toExec = toExec.replace("{{cctx}}", "--context " + p_in['ctx'])
                    toExec = toExec.replace("{{ctx}}", p_in['ctx'])
                    if p_in['ns'] != P_UNKNOWN and p_in['ns'] != "<none>":
                        toExec = toExec.replace("{{cns}}", " -n " + p_in['ns'])
                        toExec = toExec.replace("{{ns}}", p_in['ns'])
                    else:
                        toExec = toExec.replace("{{cns}}","")
            else: # ctx, kc
                if p_in['nsed'] == 'false':
                    toExec = toCheck.replace(" _ ", " {{ckc}} {{cctx}} ")
                    toExec = toExec.replace("{{ckc}}", "--kubeconfig " + p_in['kc'])
                    toExec = toExec.replace("{{kc}}", p_in['kc'])
                    toExec = toExec.replace("{{cctx}}", "--context " + p_in['ctx'])
                    toExec = toExec.replace("{{ctx}}", p_in['ctx'])
                else:
                    toExec = toCheck.replace(" _ ", " {{ckc}} {{cctx}} {{cns}} ")
                    toExec = toExec.replace("{{nsed}}", p_in['nsed'])
                    toExec = toExec.replace("{{ckc}}", "--kubeconfig " + p_in['kc'])
                    toExec = toExec.replace("{{kc}}", p_in['kc'])
                    toExec = toExec.replace("{{cctx}}", "--context " + p_in['ctx'])
                    toExec = toExec.replace("{{ctx}}", p_in['ctx'])
                    if p_in['ns'] != P_UNKNOWN and p_in['ns'] != "<none>":
                        toExec = toExec.replace("{{cns}}", " -n " + p_in['ns'])
                        toExec = toExec.replace("{{ns}}", p_in['ns'])
                    else:
                        toExec = toExec.replace("{{cns}}","")
        return toExec

def main_loop(args):
    global P_SHORTCUT
    all_cmds = fetch_kubectl_cmds()
    kctl_allowed = ["api-resources", "get", "config", "exec", "top"]
    prohibited = []
    for item in all_cmds:
        if item not in kctl_allowed:
            prohibited.append(item)

    kctlOptions = fetch_kubectl_options()
    internal = ["sh", "+", "-", "clean", "yaml-inject", "json-inject", "cgc","api-r", "kc-inject"]
    # TODO consider -O for _ formatting
    plugins = available_plugins()
    allowed = kctl_allowed + internal + plugins

    cmd = set_cmd_input()

    extracted,extracted_args_position,cmd = extract_args(args,cmd,kctlOptions)

    get_extracted = []
    if extracted[1] == "get":
        get_extracted = extract_get_options(cmd['ctx'], extracted,kctlOptions)
        if len(get_extracted) > 2:
            cmd['kind'] = get_extracted[2]
        if len(get_extracted) > 3:
            cmd['name'] = get_extracted[3]

    if not len(extracted) > 1:
        l_print_t(P_ERROR,"empty command or not recognized command")
        return -1

    command = extracted[1]
    if command in prohibited:
        l_print_t(P_ERROR,f"unhandled command {command}, prohibited")
        execArgs = ["kubectl"] + args[1:]
        system_exec(" ".join(execArgs))
        return -2

    if not command in allowed:
        l_print_t(P_ERROR,f"unhandled command {command}, not prohibited, not allowed")
        execArgs = ['kubectl'] + args[1:]
        print(execArgs)
        system_exec(" ".join(execArgs))
        return -3

    #all commands left are allowed
    position = []
    columns = []
    p_in = set_pipe_input()
    prev_p_in = set_pipe_input()
    if len(args) > extracted_args_position[1] + 1: # kind
        p_in['obj'] = args[extracted_args_position[1] + 1]
    line_num = 0
    prevLine = ""
    if (command == "config" and cmd['kind'] == "get-contexts") or command == "cgc":
        if detect_input() == "fifo":
            for line in sys.stdin:
                if prevLine:
                    line = prevLine + line
                if line[-1] != "\n":
                    prevLine = line
                    continue
                if line.startswith(f"#{PLUGIN_NAME}:"):
                    p_in = detect_in_plugin_content(p_in,line)
                    line_num = 0
                    continue
                else:
                    if p_in['cmd'] not in ["kc-inject",P_UNKNOWN]:
                        l_print_t(P_ERROR,
                            f"Illegal pipe pass: from {p_in['cmd']} to config_get-contexts"
                        )
                        stream_helper()
                        break
                    elif p_in['cmd'] in ["kc-inject",P_UNKNOWN]:  # command cgc, in kc-inject
                        if p_in['format'] == P_DEFAULT:
                            if line_num == 0 and line.isupper():
                                line_num += 1
                                position, columns = read_header_line(line)
                                continue
                            else: # loading fields
                                content = read_row_from_line(position, columns, line)
                                line_num += 1
                        elif p_in['format'] in ["name",P_UNKNOWN]:
                            p_in['ctx'] = line[:-1]
                            content['FILE'] = p_in['kc']
                        if detect_output() == "pipe":
                            l_print_t(PIPE_CMD_IN,"config_get-contexts")
                            if content['FILE'] != P_UNKNOWN:
                                l_print_t(PIPE_KC_IN,f"{content['FILE']}")
                            pass_output_format(args)
                        if command == "cgc":
                            if content['FILE'] != P_UNKNOWN:
                                execArgs = ["kubectl"] + ["--kubeconfig", content['FILE'], "config","get-contexts"] + args[2:]
                            else:
                                execArgs = ["kubectl"] + ['config','get-contexts'] + args[2:]
                        else:
                            if content['FILE'] != P_UNKNOWN:
                                execArgs = ["kubectl"] + ["--kubeconfig", content['FILE']] +  args[1:]
                            else:
                                execArgs = ["kubectl"] + args[1:]
                        system_exec(" ".join(execArgs))
        else:
            if detect_output() == "pipe":
                l_print_t(PIPE_CMD_IN, "config_get-contexts")
                pass_output_format(args)
            if command == "cgc":
                execArgs = ["kubectl"] + ['config', 'get-contexts'] + args[2:]
            else:
                execArgs = ["kubectl"] + args[1:]
            system_exec(" ".join(execArgs))
    elif command == "kc-inject":
        if detect_input() == "fifo":
            l_print_e(P_WARNING, f"Illegal pipe pass: to config get-contexts, ignored")
        else:
            if detect_output() == "pipe":
                l_print_t(PIPE_CMD_IN, f"{command}")
            pass_output_format(args)
            out_list = []
            for i in args[2:]:
                if os.path.exists(i):
                    out_list.append(i)
                else:
                    l_print_e(P_WARNING,f"file {i} does note exist")
            if out_list:
                print("FILE")
            for i in out_list:
                print(i)
    elif command in ["+", "-"]:# TODO convert to new format
        if detect_input() == "fifo":
            for line in sys.stdin:
                if prevLine:
                    line = prevLine + line
                if line[-1] != "\n":
                    prevLine = line
                    continue

                if line[0:len(PLUGIN_NAME) + 2] == f"#{PLUGIN_NAME}:":
                    print(line, end="")
                else:
                    if args[1] == "-":
                        match = False
                        for i in args[2:]:
                            if re.search(i, line):
                                match = True
                        if not match:
                            print(line, end="")
                    elif args[1] == "+":
                        for i in args[2:]:
                            if re.search(i, line):
                                print(line, end="")
                                break
        else:
            l_print_t(P_ERROR,f"no pipe input for {command}")
    elif command == 'clean':
        if cmd['kind'] == "headers":
            for line in sys.stdin:
                if not line.isupper() and not line.startswith(f"#{PLUGIN_NAME}:"):
                    print(line,end="")
       # TODO additional clean arguments like clean columns
       #  elif cmd['kind'] == "columns": # TODO
       #      columns_to_clean = extracted[3:]
       #      line_num = 0
       #      for line in sys.stdin:
       #          if line_num == 0 and line.isupper():
       #              line_num += 1
       #              continue
       #          else:  # loading fields
       #              content = read_row_from_line(position, columns,line)
       #              line_num += 1
        else:
            for line in sys.stdin:
                if not line.startswith(f"#{PLUGIN_NAME}:"):
                    print(line, end="")
    elif command == "yaml-inject":
        plugin_content = True
        for line in sys.stdin:
            if line.startswith(f"#{PLUGIN_NAME}:"):
                plugin_content = True
                if line.startswith(f"#{PLUGIN_NAME}:{PIPE_CTX_IN}: "):
                    p_in = detect_in_plugin_content(p_in,line)
            else:
                if plugin_content and p_in['ctx'] != P_UNKNOWN:
                    print(f"---\ncontext: {p_in['ctx']}\n", end="")
                plugin_content = False
                print(line, end="")
