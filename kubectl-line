def int_signal_handler(sig, frame):
    print(f"Exit on Ctrl+C!")
    os.kill(os.getppid(), signal.SIGTERM)
    sys.exit(0)


def signal_ignore(sig, frame):
    pass


def term_signal_handler(sig, frame):
    sys.exit(0)


def detect_input():
    if sys.stdin.isatty():
        return "terminal"
    else:
        if S_ISFIFO(os.fstat(0).st_mode):
            return "fifo"
        else:
            return "pipe"


def detect_output():
    if sys.stdout.isatty():
        return "terminal"
    else:
        return "pipe"

