# not all commands use, so none of cmd_* are used in config_get-contexts
# * api-resources uses cmd['ctx'] and cmd['ns'] if present in command line to pass those via #pipe
# * get: uses cmd['ctx']/cmd['ns']/cmd['kind']/cmd['name'] if is first command in pipe sequence
#      to pass those to next pipe, but NOTE get ns | get .. is special case !!
#
# config get-contexts :
# - takes : nothing
# - provides: context, as column NAME
# api-resources:
# - takes context as #pipe
# - provides p_in['kind'] as column KIND:


