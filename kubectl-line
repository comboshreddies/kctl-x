                                toExec = toExec.replace("--no-headers", "")
                        for item in content:
                            toExec = toExec.replace("{{" + item + "}}", content[item])
                        system_exec(toExec)
                    elif p_in["cmd"] == "api-resources":  # in cmd get
                        if p_in["format"] in [P_DEFAULT, "wide"]:
                            if line_num == 0 and line.isupper():
