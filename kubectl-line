    else:
        execArgs = ["kubectl", "api-resources", "--verbs=get,list", "--no-headers"]
    result = subprocess.run(execArgs, capture_output=True, text=True, check=True)
    command_output = result.stdout
    lines = command_output.split("\n")
    list = []
    for line in lines:
        sublist = []
        words = line.split()
        if len(words) == 5:
            sublist = words
        elif len(words) == 4:
            sublist = [words[0], "", words[1], words[2], words[3]]
        list.append(sublist)
    return list


def fetch_kubectl_cmd_options(cmd, context=""):
    if context:
        execArgs = ["kubectl", "--context", context, cmd, "-h"]
    else:
        execArgs = ["kubectl", cmd, "-h"]
    result = subprocess.run(execArgs, capture_output=True, text=True, check=True)
    command_output = result.stdout
    lines = command_output.split("\n")
    list = []
    skip = True
    for line in lines:
        if line == "Options:":
            skip = False
        if line == "Usage:":
            break
        if skip:
            continue
        left_part = line.split(':')[0]
        words = left_part.split()
        if len(words) > 0 and words[0][0] == '-':
            for word in words:
                if word[0] == "-" and word[0:2] != "--" and word[-1] == ",":
                    list.append(word[:-1])
                if word[0:2] == "--" and "=" in word:
                    list.append(word[:word.index('=')])
    return list

